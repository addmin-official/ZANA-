{
  "name": "zana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:client": "vite build",
    "build:worker": "echo 'Worker deployed via Wrangler'",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "predeploy:cloudflare": "node scripts/check-secrets.js",
    "deploy:cloudflare": "wrangler deploy",
    "predeploy": "node scripts/check-secrets.js",
    "deploy": "wrangler deploy",
    "test": "node --import tsx --import ./src/test/setupEnv.ts --test src/curriculum/curriculum.test.ts src/learning/engine/AdaptiveLearningEngine.test.ts src/learning/providers/LearningSecurity.test.ts src/assessment/AssessmentIntelligence.test.ts src/planning/planning.test.ts src/worker/worker.test.ts src/test/resolve-kv.test.ts src/test/firebaseAndBoundaries.test.ts",
    "test:architecture": "node --import tsx --import ./src/test/setupEnv.ts --test src/test/firebaseAndBoundaries.test.ts",
    "test:security": "node --import tsx --import ./src/test/setupEnv.ts --test src/learning/providers/LearningSecurity.test.ts",
    "test:rtl": "node --import tsx --import ./src/test/setupEnv.ts --test src/test/rtl.test.ts",
    "test:smoke": "node scripts/smoke-test.js",
    "test:sorani": "node --import tsx --import ./src/test/setupEnv.ts --test src/test/sorani.test.ts",
    "test:worker": "node --import tsx --import ./src/test/setupEnv.ts --test src/worker/worker.test.ts",
    "verify:finalization": "node scripts/verify-finalization-contract.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.22.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "wrangler": "^4.112.0"
  }
}